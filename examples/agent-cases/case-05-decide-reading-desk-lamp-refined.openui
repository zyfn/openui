fit = Stack([fitTitle, fitList], "column", "xs")
fitTitle = MarkDownRenderer("## 用法不同，选择也不同")
fitList = EntityList([{"left":"读完需要收起来","right":"先比较折叠款的尺寸"},{"left":"桌面几乎放不下灯座","right":"核对夹式灯与桌沿是否匹配"},{"left":"希望移动使用","right":"比较充电方式和续航条件"}], "small")
