root=Stack([heading,viewSwitcher,activeView,placesMap,transport,stays,budget,closing],"column","l")
heading=Stack([TextContent(headline,"large-heavy"),TextContent("11 月 5–6 日 · 两位成人","small")],"column","s")
headline="巴黎，两天一晚"
input={"provenance":{"kind":"mock-tool-results","prices":"simulated, not live offers","media":"illustrative local review assets","coordinates":"simulated fixture coordinates","urls":"supplied provider or collection entry pages, not reserved inventory","routes":"no navigation geometry supplied"},"trip":{"start":"2026-11-05","end":"2026-11-06","adults":2,"days":2,"nights":1,"rooms":1,"currency":"€"},"flightGroups":[{"id":"outbound","title":"去程 · 11月5日","route":"LHR → CDG","origin":"LHR","destination":"CDG","options":[{"id":"out1","carrier":"British Airways","departure":"08:00","arrival":"10:20","price":150,"stops":"直飞","duration":"1h 20m","detail":"经济舱","url":"https://www.britishairways.com/travel/home/public/en_gb/"},{"id":"out2","carrier":"Air France","departure":"09:30","arrival":"11:50","price":190,"stops":"直飞","duration":"1h 20m","detail":"经济舱","url":"https://www.airfrance.com/"},{"id":"out3","carrier":"KLM","departure":"08:00","arrival":"13:15","price":135,"stops":"中转 1 次","duration":"4h 15m","detail":"AMS 停留 1小时30分","url":"https://www.klm.com/"}]},{"id":"inbound","title":"返程 · 11月6日","route":"CDG → LHR","origin":"CDG","destination":"LHR","options":[{"id":"back1","carrier":"British Airways","departure":"18:30","arrival":"18:50","price":170,"stops":"直飞","duration":"1h 20m","detail":"经济舱","url":"https://www.britishairways.com/travel/home/public/en_gb/"},{"id":"back2","carrier":"Air France","departure":"20:00","arrival":"20:20","price":195,"stops":"直飞","duration":"1h 20m","detail":"经济舱","url":"https://www.airfrance.com/"},{"id":"back3","carrier":"KLM","departure":"13:30","arrival":"16:35","price":125,"stops":"中转 1 次","duration":"4h 05m","detail":"AMS 停留 1小时20分","url":"https://www.klm.com/"}]}],"stays":[{"id":"central","name":"左岸 · 花园双人房","image":"/stay-central.jpg","description":"花园朝向的双人房。","tags":["花园景观","含早餐"],"pricePerRoomNight":220,"url":"https://www.booking.com/searchresults.html?ss=Paris&checkin=2026-11-05&checkout=2026-11-06&group_adults=2&no_rooms=1"},{"id":"outer","name":"近交通站 · 大床房","image":"/stay-transit.jpg","description":"靠近公共交通的城景大床房。","tags":["城景","大床"],"pricePerRoomNight":160,"url":"https://www.booking.com/searchresults.html?ss=Paris&checkin=2026-11-05&checkout=2026-11-06&group_adults=2&no_rooms=1"},{"id":"riverside","name":"河畔 · 景观房","image":"/stay-central.jpg","description":"河景双人房，含早餐。","tags":["河景","含早餐"],"pricePerRoomNight":280,"url":"https://www.booking.com/searchresults.html?ss=Paris&checkin=2026-11-05&checkout=2026-11-06&group_adults=2&no_rooms=1"}],"places":[{"id":"louvre","name":"卢浮宫","image":"/paris-louvre-day.jpg","description":"法国国王昔日的宫殿，馆藏横跨近一万年的艺术史。","tags":["博物馆","非 EEA 票"],"unitPrice":32,"priceBasis":"非 EEA 成人","url":"https://ticket.louvre.fr/en","lat":48.8606,"lng":2.3376,"icon":"building.columns","booking":true},{"id":"germain","name":"圣日耳曼街区","image":"/paris-cafe.jpg","description":"文学咖啡馆、教堂与左岸街巷。","tags":["左岸","免费"],"unitPrice":0,"priceBasis":"公共街区","url":"https://parisjetaime.com/eng/article/a-walk-in-saint-germain-des-pres-a925","lat":48.8539,"lng":2.3332,"icon":"building.2","booking":false},{"id":"eiffel","name":"埃菲尔铁塔 · 二层","image":"/paris-eiffel.jpg","description":"电梯到二层，不含顶层。","tags":["二层","25 岁以上成人"],"unitPrice":23.5,"priceBasis":"25 岁以上成人","url":"https://ticket.toureiffel.paris/en","lat":48.8584,"lng":2.2945,"icon":"building","booking":true},{"id":"cruise","name":"塞纳河观光游船","image":"/paris-cruise.jpg","description":"一小时观光游船，含语音导览。","tags":["1 小时","语音导览"],"unitPrice":18,"priceBasis":"成人网络票","url":"https://www.bateauxparisiens.com/en/cruise-tours/guided-tour.html","lat":48.86039,"lng":2.29353,"icon":"ferry","booking":true},{"id":"cafe","name":"双叟咖啡馆","image":"/paris-cafe.jpg","description":"圣日耳曼广场的文学咖啡馆。","tags":["咖啡馆"],"unitPrice":null,"priceBasis":null,"url":"https://lesdeuxmagots.fr/en/","lat":48.85389,"lng":2.33306,"icon":"cup.and.saucer","booking":false}],"routes":[],"budgetAssumptions":{"food":160,"localTransport":80,"buffer":60}}
trip=input.trip
currency=trip.currency
$view="overview"
outboundGroup=input.flightGroups[0]
returnGroup=input.flightGroups[1]
recommendedOutbound=input.flightGroups[0].options[0]
recommendedReturn=input.flightGroups[1].options[0]
recommendedStay=input.stays[0]
flightCost=recommendedOutbound.price+recommendedReturn.price
stayCost=recommendedStay.pricePerRoomNight*trip.rooms*trip.nights
visitCost=(input.places[0].unitPrice+input.places[1].unitPrice+input.places[2].unitPrice+input.places[3].unitPrice)*trip.adults
total=flightCost+stayCost+visitCost+input.budgetAssumptions.food+input.budgetAssumptions.localTransport+input.budgetAssumptions.buffer
viewSwitcher=Buttons([ Button("总览",@Set($view,"overview"),$view=="overview"?"primary":"secondary",null,"small"), Button("第一天",@Set($view,"day1"),$view=="day1"?"primary":"secondary",null,"small"), Button("第二天",@Set($view,"day2"),$view=="day2"?"primary":"secondary",null,"small") ],"row")
activeView=$view=="overview"?routeSummary:($view=="day1"?dayOne:dayTwo)
dayOne=Stack([ InlineHeader("第一天 · 艺术与左岸","11 月 5 日"), TextContent("上午抵达后寄存行李。下午看卢浮宫，傍晚穿过塞纳河去左岸。","small"), Stack([ Image(input.places[0].name,input.places[0].image), Stack([TextContent(input.places[0].name,"small-heavy"),TagBlock(input.places[0].tags,"sm"),TextContent(input.places[0].description,"small"), Stack([BoldText("number",currency+(input.places[0].unitPrice*trip.adults),null,"text","lg"), Buttons([Button(input.places[0].booking?"订":"详情",@OpenUrl(input.places[0].url),"primary",null,"small")])],"row","s","center","between",false) ],"column","s","stretch","between",false) ],"row","m","stretch","start",false),Separator(),Stack([ Image(input.places[1].name,input.places[1].image), Stack([TextContent(input.places[1].name,"small-heavy"),TagBlock(input.places[1].tags,"sm"),TextContent(input.places[1].description,"small"), Stack([BoldText("number",currency+(input.places[1].unitPrice*trip.adults),null,"text","lg"), Buttons([Button(input.places[1].booking?"订":"详情",@OpenUrl(input.places[1].url),"primary",null,"small")])],"row","s","center","between",false) ],"column","s","stretch","between",false) ],"row","m","stretch","start",false),Separator(), ListBlock([ListItem(input.places[4].name,input.places[4].description,{src:input.places[4].image,alt:input.places[4].name})],"image") ],"column","m")
dayTwo=Stack([ InlineHeader("第二天 · 铁塔与塞纳","11 月 6 日"), Stack([ Image(input.places[2].name,input.places[2].image), Stack([TextContent(input.places[2].name,"small-heavy"),TagBlock(input.places[2].tags,"sm"),TextContent(input.places[2].description,"small"), Stack([BoldText("number",currency+(input.places[2].unitPrice*trip.adults),null,"text","lg"), Buttons([Button(input.places[2].booking?"订":"详情",@OpenUrl(input.places[2].url),"primary",null,"small")])],"row","s","center","between",false) ],"column","s","stretch","between",false) ],"row","m","stretch","start",false),Separator(),Stack([ Image(input.places[3].name,input.places[3].image), Stack([TextContent(input.places[3].name,"small-heavy"),TagBlock(input.places[3].tags,"sm"),TextContent(input.places[3].description,"small"), Stack([BoldText("number",currency+(input.places[3].unitPrice*trip.adults),null,"text","lg"), Buttons([Button(input.places[3].booking?"订":"详情",@OpenUrl(input.places[3].url),"primary",null,"small")])],"row","s","center","between",false) ],"column","s","stretch","between",false) ],"row","m","stretch","start",false), TextContent("午餐后取行李，计划 15:00 离开市区；为推荐的 18:30 航班留出接驳和安检时间。","small") ],"column","m")
placesMap=Stack([InlineHeader("都在这张地图上"),Map(@Each(input.places,"p",{id:p.id,title:p.name,lat:p.lat,lng:p.lng,imageSrc:p.image,subtitle:p.description,url:p.url,icon:p.icon}),input.routes,null,"regular","wgs84")],"column","m")
routeSummary=Stack([InlineHeader("两天路线"),EntityList([ {left:"第一天",right:"卢浮宫 → 圣日耳曼",rightVariant:"text"}, {left:"第二天",right:"埃菲尔铁塔 → 塞纳河",rightVariant:"text"} ],"small")],"column","s")
transport=Stack([ InlineHeader("往返航班"), TextContent("时间均为当地时间；每张卡显示两位成人该单程的价格。","small"), InlineHeader(outboundGroup.title,outboundGroup.route), CompositeCardBlock(@Each(outboundGroup.options,"f",CompositeCardItem(f.id, Stack([Icon("plane"),TextContent(f.carrier,"small-heavy"),TextContent(outboundGroup.route,"small")],"row","s","center","start",false),[ Stack([ Stack([TextContent(f.departure,"large-heavy"),TextContent(outboundGroup.origin,"small")],"column","xs"), Stack([TextContent(f.duration,"small"),TextContent(f.stops,"small-heavy")],"column","xs","center"), Stack([TextContent(f.arrival,"large-heavy"),TextContent(outboundGroup.destination,"small")],"column","xs") ],"row","s","center","between",false), TextContent(f.detail,"small") ],{price:BoldText("number",currency+f.price,null,"text","lg"),button:Button("订",@OpenUrl(f.url),"primary",null,"small")} )),"carousel",true), InlineHeader(returnGroup.title,returnGroup.route), CompositeCardBlock(@Each(returnGroup.options,"f",CompositeCardItem(f.id, Stack([Icon("plane"),TextContent(f.carrier,"small-heavy"),TextContent(returnGroup.route,"small")],"row","s","center","start",false),[ Stack([ Stack([TextContent(f.departure,"large-heavy"),TextContent(returnGroup.origin,"small")],"column","xs"), Stack([TextContent(f.duration,"small"),TextContent(f.stops,"small-heavy")],"column","xs","center"), Stack([TextContent(f.arrival,"large-heavy"),TextContent(returnGroup.destination,"small")],"column","xs") ],"row","s","center","between",false), TextContent(f.detail,"small") ],{price:BoldText("number",currency+f.price,null,"text","lg"),button:Button("订",@OpenUrl(f.url),"primary",null,"small")} )),"carousel",true) ],"column","m")
stays=Stack([InlineHeader("住一晚，选一处落脚点"),CompositeCardBlock(@Each(input.stays,"h",CompositeCardItem(h.id,ImageTextLarge(h.image,h.name,h.name,null,true),[ TagBlock(h.tags,"sm"),Text("text",h.description) ],{price:BoldText("number",currency+(h.pricePerRoomNight*trip.rooms*trip.nights),null,"text","lg"),button:Button("订",@OpenUrl(h.url),"primary",null,"small")})),"carousel",true)],"column","m")
budget=Stack([InlineHeader("推荐方案预算"),BoldText("number",currency+total,trip.adults+" 人合计 · 含余量","text","lg"),PieChart([ "机票","住宿","餐饮","接驳与交通","门票","余量" ],[flightCost,stayCost,input.budgetAssumptions.food,input.budgetAssumptions.localTransport,visitCost,input.budgetAssumptions.buffer],"donut")],"column","m")
closing=TextContent("先确认去返航班与房间库存，再预约卢浮宫时段；餐饮与市内交通留有预算余量。","small-heavy")
