root=Stack([heading,transport,itinerary,stays,placesMap,budget,closing],"column","l")
heading=Stack([TextContent(headline,"large-heavy"),TextContent("5–6 November 2026 · two adults","small")],"column","s")
headline="Paris, two days and one night"
input={"provenance":{"kind":"mock-tool-results","prices":"simulated, not live offers","media":"illustrative local review assets","coordinates":"simulated fixture coordinates","urls":"supplied provider or collection entry pages, not reserved inventory","routes":"no navigation geometry supplied"},"trip":{"start":"2026-11-05","end":"2026-11-06","adults":2,"days":2,"nights":1,"rooms":1,"currency":"€"},"flightGroups":[{"id":"outbound","title":"Outbound · 5 Nov","route":"LHR → CDG","origin":"LHR","destination":"CDG","options":[{"id":"out1","carrier":"British Airways","departure":"08:00","arrival":"10:20","price":150,"stops":"Nonstop","duration":"1h 20m","detail":"Economy","url":"https://www.britishairways.com/travel/home/public/en_gb/"},{"id":"out2","carrier":"Air France","departure":"09:30","arrival":"11:50","price":190,"stops":"Nonstop","duration":"1h 20m","detail":"Economy","url":"https://www.airfrance.com/"},{"id":"out3","carrier":"KLM","departure":"08:00","arrival":"13:15","price":135,"stops":"1 stop","duration":"4h 15m","detail":"AMS layover · 1h 30m","url":"https://www.klm.com/"}]},{"id":"inbound","title":"Return · 6 Nov","route":"CDG → LHR","origin":"CDG","destination":"LHR","options":[{"id":"back1","carrier":"British Airways","departure":"18:30","arrival":"18:50","price":170,"stops":"Nonstop","duration":"1h 20m","detail":"Economy","url":"https://www.britishairways.com/travel/home/public/en_gb/"},{"id":"back2","carrier":"Air France","departure":"20:00","arrival":"20:20","price":195,"stops":"Nonstop","duration":"1h 20m","detail":"Economy","url":"https://www.airfrance.com/"},{"id":"back3","carrier":"KLM","departure":"13:30","arrival":"16:35","price":125,"stops":"1 stop","duration":"4h 05m","detail":"AMS layover · 1h 20m","url":"https://www.klm.com/"}]}],"stays":[{"id":"central","name":"Left Bank · garden double","image":"/stay-central.jpg","description":"A garden-facing double room.","tags":["Garden view","Breakfast included"],"pricePerRoomNight":220,"url":"https://www.booking.com/searchresults.html?ss=Paris&checkin=2026-11-05&checkout=2026-11-06&group_adults=2&no_rooms=1"},{"id":"outer","name":"Transit-side king room","image":"/stay-transit.jpg","description":"A city-view king room near public transport.","tags":["City view","King bed"],"pricePerRoomNight":160,"url":"https://www.booking.com/searchresults.html?ss=Paris&checkin=2026-11-05&checkout=2026-11-06&group_adults=2&no_rooms=1"},{"id":"riverside","name":"Riverside view room","image":"/stay-central.jpg","description":"River-view double room with breakfast.","tags":["River view","Breakfast included"],"pricePerRoomNight":280,"url":"https://www.booking.com/searchresults.html?ss=Paris&checkin=2026-11-05&checkout=2026-11-06&group_adults=2&no_rooms=1"}],"places":[{"id":"louvre","name":"The Louvre","image":"/paris-louvre-day.jpg","description":"A former royal palace with collections spanning nearly 10,000 years.","tags":["Museum","Non-EEA fare"],"unitPrice":32,"priceBasis":"Non-EEA adult","url":"https://ticket.louvre.fr/en","lat":48.8606,"lng":2.3376,"icon":"building.columns","booking":true},{"id":"germain","name":"Saint-Germain-des-Prés","image":"/paris-cafe.jpg","description":"Literary cafés, a historic church and Left Bank streets.","tags":["Left Bank","Free"],"unitPrice":0,"priceBasis":"Public streets","url":"https://parisjetaime.com/eng/article/a-walk-in-saint-germain-des-pres-a925","lat":48.8539,"lng":2.3332,"icon":"building.2","booking":false},{"id":"eiffel","name":"Eiffel Tower · second floor","image":"/paris-eiffel.jpg","description":"Elevator access to the second floor, excluding the summit.","tags":["Second floor","Adult 25+"],"unitPrice":23.5,"priceBasis":"Adult over 24","url":"https://ticket.toureiffel.paris/en","lat":48.8584,"lng":2.2945,"icon":"building","booking":true},{"id":"cruise","name":"Seine sightseeing cruise","image":"/paris-cruise.jpg","description":"One-hour sightseeing cruise with an audio guide.","tags":["1 hour","Audio guide"],"unitPrice":18,"priceBasis":"Adult online fare","url":"https://www.bateauxparisiens.com/en/cruise-tours/guided-tour.html","lat":48.86039,"lng":2.29353,"icon":"ferry","booking":true},{"id":"cafe","name":"Les Deux Magots","image":"/paris-cafe.jpg","description":"A literary café on Place Saint-Germain-des-Prés.","tags":["Café"],"unitPrice":null,"priceBasis":null,"url":"https://lesdeuxmagots.fr/en/","lat":48.85389,"lng":2.33306,"icon":"cup.and.saucer","booking":false}],"routes":[],"budgetAssumptions":{"food":160,"localTransport":80,"buffer":60}}
trip=input.trip
currency=trip.currency
$view="overview"
outboundGroup=input.flightGroups[0]
returnGroup=input.flightGroups[1]
recommendedOutbound=input.flightGroups[0].options[0]
recommendedReturn=input.flightGroups[1].options[0]
recommendedStay=input.stays[0]
flightArrow=Stack([Stack([Separator()],"column","none"),Icon("move-right")],"row","none","center","start",false)
flightCost=recommendedOutbound.price+recommendedReturn.price
stayCost=recommendedStay.pricePerRoomNight*trip.rooms*trip.nights
visitCost=(input.places[0].unitPrice+input.places[1].unitPrice+input.places[2].unitPrice+input.places[3].unitPrice)*trip.adults
total=flightCost+stayCost+visitCost+input.budgetAssumptions.food+input.budgetAssumptions.localTransport+input.budgetAssumptions.buffer
transport=Stack([ InlineHeader("Flights, each way","Local times · one-way fares for two"), InlineHeader(outboundGroup.title,outboundGroup.route), CompositeCardBlock(@Each(outboundGroup.options,"f",CompositeCardItem(f.id, Stack([TextContent(f.carrier,"small-heavy"),TagBlock([f.id==recommendedOutbound.id?"Recommended":"Alternative"],"sm")],"row","s","center","between",false),[ Stack([ Stack([BoldText("number",f.departure,null,"text","lg"),TextContent(outboundGroup.origin,"small")],"column","xs"), Stack([TextContent(f.duration,"small"),flightArrow,TextContent(f.stops,"small-heavy")],"column","xs","center"), Stack([BoldText("number",f.arrival,null,"text","lg"),TextContent(outboundGroup.destination,"small")],"column","xs") ],"row","s","center","between",false), TextContent(f.detail,"small") ],{price:BoldText("number",currency+f.price,null,"text","md"),button:Button("Book",@OpenUrl(f.url),"primary",null,"small")} )),"carousel",true), InlineHeader(returnGroup.title,returnGroup.route), CompositeCardBlock(@Each(returnGroup.options,"f",CompositeCardItem(f.id, Stack([TextContent(f.carrier,"small-heavy"),TagBlock([f.id==recommendedReturn.id?"Recommended":"Alternative"],"sm")],"row","s","center","between",false),[ Stack([ Stack([BoldText("number",f.departure,null,"text","lg"),TextContent(returnGroup.origin,"small")],"column","xs"), Stack([TextContent(f.duration,"small"),flightArrow,TextContent(f.stops,"small-heavy")],"column","xs","center"), Stack([BoldText("number",f.arrival,null,"text","lg"),TextContent(returnGroup.destination,"small")],"column","xs") ],"row","s","center","between",false), TextContent(f.detail,"small") ],{price:BoldText("number",currency+f.price,null,"text","md"),button:Button("Book",@OpenUrl(f.url),"primary",null,"small")} )),"carousel",true) ],"column","m")
itinerary=Stack([InlineHeader("Your two-day itinerary"),viewSwitcher,activeView],"column","m")
viewSwitcher=Buttons([ Button("Overview",@Set($view,"overview"),$view=="overview"?"primary":"secondary",null,"small"), Button("Day 1",@Set($view,"day1"),$view=="day1"?"primary":"secondary",null,"small"), Button("Day 2",@Set($view,"day2"),$view=="day2"?"primary":"secondary",null,"small") ],"row")
activeView=$view=="overview"?routeSummary:($view=="day1"?dayOne:dayTwo)
routeSummary=Steps([ StepsItem("Day 1 · Art and the Left Bank", recommendedOutbound.arrival+" arrival, the Louvre in the afternoon, then Saint-Germain and a café. Stay: "+recommendedStay.name), StepsItem("Day 2 · Tower and Seine", "Tower in the morning and a midday cruise; collect bags after lunch, leave for the airport at 15:00 for the "+recommendedReturn.departure+" return from CDG.") ])
stays=Stack([InlineHeader("A place to stay","Recommended: "+recommendedStay.name),CompositeCardBlock(@Each(input.stays,"h",CompositeCardItem(h.id,ImageTextLarge(h.image,h.name,h.name,null,true),[ TagBlock(h.tags,"sm"),Text("text",h.description) ],{price:BoldText("number",currency+(h.pricePerRoomNight*trip.rooms*trip.nights),null,"text","lg"),button:Button("Book",@OpenUrl(h.url),"primary",null,"small")})),"carousel",true)],"column","m")
placesMap=Stack([InlineHeader("Your places, on one map"),Map(@Each(input.places,"p",{id:p.id,title:p.name,lat:p.lat,lng:p.lng,imageSrc:p.image,subtitle:p.description,url:p.url,icon:p.icon}),input.routes,null,"regular","wgs84")],"column","m")
budget=Stack([InlineHeader("Recommended plan budget"),BoldText("number",currency+total,trip.adults+" people · including buffer","text","lg"),PieChart([ "Flights","Stay","Food","Transport","Tickets","Buffer" ],[flightCost,stayCost,input.budgetAssumptions.food,input.budgetAssumptions.localTransport,visitCost,input.budgetAssumptions.buffer],"donut")],"column","m")
closing=TextContent("The schedule and budget use the recommended flights and room. Confirm those before reserving attractions; a later arrival or earlier return needs a shorter day plan.","small")
dayOne=Stack([ TextContent("5 November · Art and the Left Bank","small"), TextContent(recommendedOutbound.arrival+" arrival at CDG. Transfer to the Left Bank, leave bags and have lunch.","small"), Stack([ Image(input.places[0].name,input.places[0].image), Stack([TextContent("14:00–17:00","small"),BoldText("text",input.places[0].name,null,"text","md"),TagBlock(input.places[0].tags,"sm"),TextContent(input.places[0].description,"small"), Stack([BoldText("number",currency+(input.places[0].unitPrice*trip.adults),null,"text","md"), Buttons([Button(input.places[0].booking?"Book":"Details",@OpenUrl(input.places[0].url),"primary",null,"small")])],"row","s","center","between",false) ],"column","xs","stretch","start",false) ],"row","m","stretch","start",false), TextContent("After the museum, walk across the Seine for an evening in Saint-Germain.","small"), Separator(),Stack([ Image(input.places[1].name,input.places[1].image), Stack([TextContent("17:30–18:30","small"),BoldText("text",input.places[1].name,null,"text","md"),TagBlock(input.places[1].tags,"sm"),TextContent(input.places[1].description,"small"), Stack([BoldText("number",currency+(input.places[1].unitPrice*trip.adults),null,"text","md"), Buttons([Button(input.places[1].booking?"Book":"Details",@OpenUrl(input.places[1].url),"primary",null,"small")])],"row","s","center","between",false) ],"column","xs","stretch","start",false) ],"row","m","stretch","start",false),Separator(), Stack([TextContent("Food & a pause","small-heavy"), ListBlock([ListItem(input.places[4].name,input.places[4].description,{src:input.places[4].image,alt:input.places[4].name})],"image","small")],"column","s"), TextContent("After dinner, check in: "+recommendedStay.name,"small") ],"column","m")
dayTwo=Stack([ TextContent("6 November · Tower and Seine","small"), TextContent("08:30 check out, arrange bag storage and head to the tower.","small"), Stack([ Image(input.places[2].name,input.places[2].image), Stack([TextContent("09:30–11:00","small"),BoldText("text",input.places[2].name,null,"text","md"),TagBlock(input.places[2].tags,"sm"),TextContent(input.places[2].description,"small"), Stack([BoldText("number",currency+(input.places[2].unitPrice*trip.adults),null,"text","md"), Buttons([Button(input.places[2].booking?"Book":"Details",@OpenUrl(input.places[2].url),"primary",null,"small")])],"row","s","center","between",false) ],"column","xs","stretch","start",false) ],"row","m","stretch","start",false), TextContent("Walk to the cruise pier near the tower for the chosen departure.","small"), Separator(),Stack([ Image(input.places[3].name,input.places[3].image), Stack([TextContent("11:30–12:30","small"),BoldText("text",input.places[3].name,null,"text","md"),TagBlock(input.places[3].tags,"sm"),TextContent(input.places[3].description,"small"), Stack([BoldText("number",currency+(input.places[3].unitPrice*trip.adults),null,"text","md"), Buttons([Button(input.places[3].booking?"Book":"Details",@OpenUrl(input.places[3].url),"primary",null,"small")])],"row","s","center","between",false) ],"column","xs","stretch","start",false) ],"row","m","stretch","start",false), TextContent("After lunch, collect bags and leave for CDG at 15:00 for the "+recommendedReturn.departure+" flight.","small") ],"column","m")
