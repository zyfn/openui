root=Stack([heading,overview,itinerary,placesMap,transport,stays,budget,closing],"column","l")
input={"provenance":{"kind":"mock-tool-results","prices":"simulated, not live offers","media":"illustrative local review assets","coordinates":"simulated fixture coordinates","urls":"supplied provider or collection entry pages, not reserved inventory","routes":"no navigation geometry supplied"},"trip":{"start":"2026-11-05","end":"2026-11-06","adults":2,"days":2,"nights":1,"rooms":1,"currency":"€"},"flightGroups":[{"id":"outbound","title":"Outbound · 5 Nov","route":"LHR → CDG","options":[{"id":"out1","carrier":"British Airways","departure":"08:00","arrival":"10:20","price":150,"stops":"Nonstop","duration":"1h 20m","detail":"Economy","url":"https://www.britishairways.com/travel/home/public/en_gb/"},{"id":"out2","carrier":"Air France","departure":"09:30","arrival":"11:50","price":190,"stops":"Nonstop","duration":"1h 20m","detail":"Economy","url":"https://www.airfrance.com/"},{"id":"out3","carrier":"KLM","departure":"08:00","arrival":"13:15","price":135,"stops":"1 stop","duration":"4h 15m","detail":"AMS layover · 1h 30m","url":"https://www.klm.com/"}]},{"id":"inbound","title":"Return · 6 Nov","route":"CDG → LHR","options":[{"id":"back1","carrier":"British Airways","departure":"18:30","arrival":"18:50","price":170,"stops":"Nonstop","duration":"1h 20m","detail":"Economy","url":"https://www.britishairways.com/travel/home/public/en_gb/"},{"id":"back2","carrier":"Air France","departure":"20:00","arrival":"20:20","price":195,"stops":"Nonstop","duration":"1h 20m","detail":"Economy","url":"https://www.airfrance.com/"},{"id":"back3","carrier":"KLM","departure":"13:30","arrival":"16:35","price":125,"stops":"1 stop","duration":"4h 05m","detail":"AMS layover · 1h 20m","url":"https://www.klm.com/"}]}],"stays":[{"id":"central","name":"Left Bank · garden double","image":"/stay-central.jpg","description":"A garden-facing double room.","tags":["Garden view","Breakfast included"],"pricePerRoomNight":220,"url":"https://www.booking.com/searchresults.html?ss=Paris&checkin=2026-11-05&checkout=2026-11-06&group_adults=2&no_rooms=1"},{"id":"outer","name":"Transit-side king room","image":"/stay-transit.jpg","description":"A city-view king room near public transport.","tags":["City view","King bed"],"pricePerRoomNight":160,"url":"https://www.booking.com/searchresults.html?ss=Paris&checkin=2026-11-05&checkout=2026-11-06&group_adults=2&no_rooms=1"},{"id":"riverside","name":"Riverside view room","image":"/stay-central.jpg","description":"River-view double room with breakfast.","tags":["River view","Breakfast included"],"pricePerRoomNight":280,"url":"https://www.booking.com/searchresults.html?ss=Paris&checkin=2026-11-05&checkout=2026-11-06&group_adults=2&no_rooms=1"}],"places":[{"id":"louvre","name":"The Louvre","image":"/paris-louvre.jpg","description":"A former royal palace with collections spanning nearly 10,000 years.","tags":["Art","Museum"],"unitPrice":32,"priceBasis":"Non-EEA adult","url":"https://ticket.louvre.fr/en","lat":48.8606,"lng":2.3376,"icon":"building.columns","booking":true},{"id":"germain","name":"Saint-Germain-des-Prés","image":"/paris-cafe.jpg","description":"Literary cafés, a historic church and Left Bank streets.","tags":["Left Bank","Free"],"unitPrice":0,"priceBasis":"Public streets","url":"https://parisjetaime.com/eng/article/a-walk-in-saint-germain-des-pres-a925","lat":48.8539,"lng":2.3332,"icon":"building.2","booking":false},{"id":"eiffel","name":"Eiffel Tower · second floor","image":"/paris-eiffel.jpg","description":"Elevator access to the second floor, excluding the summit.","tags":["Elevator","Second floor"],"unitPrice":23.5,"priceBasis":"Adult over 24","url":"https://ticket.toureiffel.paris/en","lat":48.8584,"lng":2.2945,"icon":"building","booking":true},{"id":"cruise","name":"Seine sightseeing cruise","image":"/paris-eiffel.jpg","description":"One-hour sightseeing cruise with an audio guide.","tags":["1 hour","Audio guide"],"unitPrice":18,"priceBasis":"Adult online fare","url":"https://www.bateauxparisiens.com/en/cruise-tours/guided-tour.html","lat":48.86039,"lng":2.29353,"icon":"ferry","booking":true},{"id":"cafe","name":"Les Deux Magots","image":"/paris-cafe.jpg","description":"A literary café on Place Saint-Germain-des-Prés.","tags":["Café"],"unitPrice":null,"priceBasis":null,"url":"https://lesdeuxmagots.fr/en/","lat":48.85389,"lng":2.33306,"icon":"cup.and.saucer","booking":false}],"routes":[],"budgetAssumptions":{"food":160,"localTransport":80,"buffer":60}}
trip=input.trip
currency=trip.currency
recommendedOutbound=input.flightGroups[0].options[0]
recommendedReturn=input.flightGroups[1].options[0]
recommendedStay=input.stays[0]
flightCost=recommendedOutbound.price+recommendedReturn.price
stayCost=recommendedStay.pricePerRoomNight*trip.rooms*trip.nights
visitCost=(input.places[0].unitPrice+input.places[1].unitPrice+input.places[2].unitPrice+input.places[3].unitPrice)*trip.adults
total=flightCost+stayCost+visitCost+input.budgetAssumptions.food+input.budgetAssumptions.localTransport+input.budgetAssumptions.buffer
heading=Stack([TextContent("Paris, two days and one night","large-heavy"),TextContent(trip.start+" — "+trip.end,"small")],"column","s")
overview=Stack([
 OverviewCardItem("people",IconText(Icon("users"),"neutral","m",trip.adults+" people",null,true,"vertical")),
 OverviewCardItem("days",IconText(Icon("calendar-days"),"neutral","m",trip.days+" days",null,true,"vertical")),
 OverviewCardItem("nights",IconText(Icon("moon"),"neutral","m",trip.nights+" night",null,true,"vertical"))
],"row","s","stretch","start",false)
itinerary=Stack([InlineHeader("Your two days"),Tabs([
 TabItem("day1","Day 1 · Art and the Left Bank",[
 TextContent("Leave bags at the hotel after arrival. Visit the Louvre in the afternoon, then cross to Saint-Germain.","small"),
 Stack([
  Image(input.places[0].name,input.places[0].image),
  Stack([TextContent(input.places[0].name,"small-heavy"),TagBlock(input.places[0].tags,"sm"),TextContent(input.places[0].description,"small"),
    Stack([BoldText("number",currency+(input.places[0].unitPrice*trip.adults),input.places[0].priceBasis+" · "+trip.adults+" people","text","lg"),
      Buttons([Button(input.places[0].booking?"Book":"Details",@OpenUrl(input.places[0].url),"primary",null,"small")])],"row","s","center","between",false)
  ],"column","s","stretch","between",false)
],"row","m","stretch","start",false),Separator(),Stack([
  Image(input.places[1].name,input.places[1].image),
  Stack([TextContent(input.places[1].name,"small-heavy"),TagBlock(input.places[1].tags,"sm"),TextContent(input.places[1].description,"small"),
    Stack([BoldText("number",currency+(input.places[1].unitPrice*trip.adults),input.places[1].priceBasis+" · "+trip.adults+" people","text","lg"),
      Buttons([Button(input.places[1].booking?"Book":"Details",@OpenUrl(input.places[1].url),"primary",null,"small")])],"row","s","center","between",false)
  ],"column","s","stretch","between",false)
],"row","m","stretch","start",false),Separator(),
 ListBlock([ListItem(input.places[4].name,input.places[4].description,{src:input.places[4].image,alt:input.places[4].name})],"image")]),
 TabItem("day2","Day 2 · Tower and Seine",[
 Stack([
  Image(input.places[2].name,input.places[2].image),
  Stack([TextContent(input.places[2].name,"small-heavy"),TagBlock(input.places[2].tags,"sm"),TextContent(input.places[2].description,"small"),
    Stack([BoldText("number",currency+(input.places[2].unitPrice*trip.adults),input.places[2].priceBasis+" · "+trip.adults+" people","text","lg"),
      Buttons([Button(input.places[2].booking?"Book":"Details",@OpenUrl(input.places[2].url),"primary",null,"small")])],"row","s","center","between",false)
  ],"column","s","stretch","between",false)
],"row","m","stretch","start",false),Separator(),Stack([
  Image(input.places[3].name,input.places[3].image),
  Stack([TextContent(input.places[3].name,"small-heavy"),TagBlock(input.places[3].tags,"sm"),TextContent(input.places[3].description,"small"),
    Stack([BoldText("number",currency+(input.places[3].unitPrice*trip.adults),input.places[3].priceBasis+" · "+trip.adults+" people","text","lg"),
      Buttons([Button(input.places[3].booking?"Book":"Details",@OpenUrl(input.places[3].url),"primary",null,"small")])],"row","s","center","between",false)
  ],"column","s","stretch","between",false)
],"row","m","stretch","start",false),
 TextContent("Collect bags after lunch and plan to leave the city at 15:00, allowing time for the recommended 18:30 flight.","small")])
])],"column","m")
placesMap=Stack([InlineHeader("Your places, on one map"),Map(@Each(input.places,"p",{id:p.id,title:p.name,lat:p.lat,lng:p.lng,imageSrc:p.image,subtitle:p.description,url:p.url,icon:p.icon}),input.routes,null,"regular","wgs84")],"column","m")
transport=Stack([InlineHeader("Getting there and back"),TextContent("Direct flights leave more time for the city; connections cost less but take longer. Times are local.","small"),Tabs(@Each(input.flightGroups,"group",TabItem(group.id,group.title,[
 CompositeCardBlock(@Each(group.options,"f",CompositeCardItem(f.id,IconText(Icon("plane"),"neutral","m",f.carrier,group.route,true),[
 BoldText("text",f.departure+" → "+f.arrival,null,"text","lg"),TagBlock([f.stops,f.duration],"sm"),Text("text",f.detail)
 ],{price:BoldText("number",currency+f.price,trip.adults+" people · one way","text","lg"),button:Button("Book",@OpenUrl(f.url),"primary",null,"small")})),"carousel",true)
])))],"column","m")
stays=Stack([InlineHeader("A place to stay"),CompositeCardBlock(@Each(input.stays,"h",CompositeCardItem(h.id,ImageTextLarge(h.image,h.name,h.name,null,true),[
 TagBlock(h.tags,"sm"),Text("text",h.description)
 ],{price:BoldText("number",currency+(h.pricePerRoomNight*trip.rooms*trip.nights),trip.rooms+" room · "+trip.nights+" night","text","lg"),button:Button("Book",@OpenUrl(h.url),"primary",null,"small")})),"carousel",true)],"column","m")
budget=Stack([InlineHeader("Recommended plan budget"),BoldText("number",currency+total,trip.adults+" people · including buffer","text","lg"),PieChart([
 "Flights","Stay","Food","Transport","Tickets","Buffer"
 ],[flightCost,stayCost,input.budgetAssumptions.food,input.budgetAssumptions.localTransport,visitCost,input.budgetAssumptions.buffer],"donut")],"column","m")
closing=Stack([TextContent("Confirm flights and room availability before booking admission slots. Changing flights also changes the arrival and departure plan.","small-heavy"),TextContent("Mock records and illustrative images, not live inventory. Food, transport and buffer are explicit planning assumptions.","small")],"column","s")
